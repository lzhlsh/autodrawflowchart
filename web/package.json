{
  "name": "@adf/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AutoDrawFlowchart frontend — draw.io editor + AI agent panel",
  "scripts": {
    "dev": "node build.mjs",
    "dev:vite": "vite",
    "build": "tsc --noEmit && node build.mjs",
    "build:vite": "tsc --noEmit && vite build",
    "build:rollup": "tsc --noEmit && node build.mjs --rollup",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rollup": "^4.63.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
